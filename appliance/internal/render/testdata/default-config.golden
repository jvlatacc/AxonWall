#!/usr/sbin/nft -f
# AxonWall managed ruleset — rendered from the declarative config store.
# Source revision: a1b2c3d4e5f6a7b8
# DO NOT EDIT — regenerated on every apply; hand edits are out of model.

flush ruleset

table inet axonwall {

    # ----- zones: interface membership (kernel device names) -----
    set zone-lan { type ifname; elements = { "enp2s0" } }
    set zone-wan { type ifname; elements = { "enp1s0" } }

    # ----- filter: one base chain per hook; first match wins -----
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
    }
    chain output {
        type filter hook output priority filter; policy accept;
        oifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
    }
}
