# AxonWall managed unbound configuration — rendered from the declarative config store.
# Source revision: a1b2c3d4e5f6a7b8
# DO NOT EDIT — regenerated on every apply; hand edits are out of model.

server:
    # Recursive, DNSSEC-validating resolver (the OPNsense-parity
    # default). The trust anchor bootstraps DNSSEC validation.
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
    # Listen on the interfaces of the zones in services.dns.listen —
    # unbound binds each named interface's addresses.
    interface: enp2s0
    interface: wg0
    # Allow the static subnets of the listened zones. Clients that
    # match no access-control line are refused (unbound's default) —
    # the firewall's input chain is the outer gate, this is the inner.
    access-control: 192.168.1.0/24 allow
