#!/usr/sbin/nft -f
# AxonWall managed ruleset — rendered from the declarative config store.
# Source revision: a1b2c3d4e5f6a7b8
# DO NOT EDIT — regenerated on every apply; hand edits are out of model.

flush ruleset

table inet axonwall {

    # ----- zones: interface membership (kernel device names) -----
    set zone-lan { type ifname; elements = { "enp2s0" } }
    set zone-wan { type ifname; elements = { "enp1s0" } }
    set zone-wg0 { type ifname; elements = { "wg0" } }

    # ----- aliases: named sets -----
    set alias-admin-hosts { type ipv4_addr; elements = { 192.168.1.10, 192.168.1.11 } }
    set alias-blocked-nets { type ipv6_addr; flags interval; elements = { 2001:db8:bad::/48 } }
    # url-table: runtime set refreshed from https://example.com/empty.txt
    set alias-empty-feed { type ipv4_addr; flags interval; }
    # url-table: runtime set refreshed from https://example.com/feeds.txt
    set alias-malware-feeds { type ipv4_addr; flags interval; }

    # ----- NAT: destination (port-forward) -----
    chain dstnat {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "enp1s0" tcp dport 8443 dnat ip to 192.168.1.50:443 comment "web-forward"
    }

    # ----- NAT: source (masquerade) -----
    chain srcnat {
        type nat hook postrouting priority srcnat; policy accept;
        iifname @zone-lan oifname "enp1s0" masquerade comment "lan-masq"
    }

    # ----- filter: one base chain per hook; first match wins -----
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
        # --- user rules: first match wins (config order) ---
        iifname @zone-lan ip saddr @alias-admin-hosts tcp dport 22 accept comment "admin-ssh"
        iifname @zone-wan udp dport 51820 accept comment "wg-handshake"
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
        # --- port-forward associations (translated destination) ---
        iifname "enp1s0" ip daddr 192.168.1.50 tcp dport 443 accept comment "web-forward (port-forward association)"
        # --- user rules: first match wins (config order) ---
        iifname @zone-lan oifname @zone-wan accept comment "lan-to-wan"
        iifname @zone-wg0 oifname @zone-lan accept comment "wg-to-lan"
        iifname @zone-lan oifname @zone-wan ip saddr @alias-admin-hosts accept comment "admin-only-out"
    }
    chain output {
        type filter hook output priority filter; policy accept;
        oifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        meta l4proto ipv6-icmp accept
        ip protocol icmp accept
    }
}
